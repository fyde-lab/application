digraph "carte-bureau" {
rankdir=TB; newrank=true; compound=true; nodesep=0.35; ranksep=0.55;
label="Fyde — carte des écrans, bureau et tablette"; labelloc=t; labeljust=l; fontsize=26; fontname="Inter SemiBold"; pad=0.4; bgcolor="#F2F0EA";
node [fontname="Inter" fontsize=13 margin="0.18,0.08" penwidth=1.2];
edge [fontname="Inter" fontsize=11 fontcolor="#3d3a33" arrowsize=0.8];
subgraph "cluster_moi" { label="Moi (M)"; fontname="Inter SemiBold"; fontsize=15; style="rounded"; color="#CFCAC0"; penwidth=1.2; margin=14;
  "M9" [label="M9\nOffres" shape=box style="rounded,filled" color="#8C877B" fillcolor="#E3DCEC"];
}
subgraph "cluster_donb" { label="Accueil et accès au bureau (DO)"; fontname="Inter SemiBold"; fontsize=15; style="rounded"; color="#CFCAC0"; penwidth=1.2; margin=14;
  "DO1" [label="DO1\nBienvenue" shape=box style="rounded,filled" color="#8C877B" fillcolor="#DCE8E0"];
  "DO2" [label="DO2\nConnexion" shape=box style="rounded,filled" color="#8C877B" fillcolor="#DCE8E0"];
  "DO2b" [label="DO2b\nConnexion en cours" shape=box style="rounded,filled" color="#8C877B" fillcolor="#DCE8E0"];
  "DO2c" [label="DO2c\nÉchec de connexion" shape=box style="rounded,filled" color="#8C877B" fillcolor="#DCE8E0"];
  "DO3" [label="DO3\nCréer le coffre" shape=box style="rounded,filled" color="#8C877B" fillcolor="#DCE8E0"];
  "DO3b" [label="DO3b\nCréer — erreurs" shape=box style="rounded,filled" color="#8C877B" fillcolor="#DCE8E0"];
  "DO4b" [label="DO4b\nTrousseau absent" shape=box style="rounded,filled" color="#8C877B" fillcolor="#DCE8E0"];
  "DO5" [label="DO5\nTrop d’appareils" shape=box style="rounded,filled" color="#8C877B" fillcolor="#DCE8E0"];
  "DO6" [label="DO6\nKit de récupération" shape=box style="rounded,filled" color="#8C877B" fillcolor="#DCE8E0"];
  "DO6b" [label="DO6b\nVérifier le kit" shape=box style="rounded,filled" color="#8C877B" fillcolor="#DCE8E0"];
  "DO7" [label="DO7\nChoisir ses sources" shape=box style="rounded,filled" color="#8C877B" fillcolor="#DCE8E0"];
  "DO7h" [label="DO7h\nLimite de l’offre" shape=box style="rounded,filled" color="#8C877B" fillcolor="#DCE8E0"];
  "DO7b" [label="DO7b\nConnecter une source" shape=box style="rounded,filled" color="#8C877B" fillcolor="#DCE8E0"];
  "DO7c" [label="DO7c\nRécupération en cours" shape=box style="rounded,filled" color="#8C877B" fillcolor="#DCE8E0"];
  "DO7d" [label="DO7d\nCode reçu (SMS ou e-mail)" shape=box style="rounded,filled" color="#8C877B" fillcolor="#DCE8E0"];
  "DO7f" [label="DO7f\nMot de passe refusé" shape=box style="rounded,filled" color="#8C877B" fillcolor="#DCE8E0"];
  "DO7g" [label="DO7g\nSources connectées" shape=box style="rounded,filled" color="#8C877B" fillcolor="#DCE8E0"];
  "DO8" [label="DO8\nNotifications" shape=box style="rounded,filled" color="#8C877B" fillcolor="#DCE8E0"];
  "DO9" [label="DO9\nOuverture" shape=box style="rounded,filled" color="#8C877B" fillcolor="#DCE8E0"];
  "DO10" [label="DO10\nRécupérer mon coffre" shape=box style="rounded,filled" color="#8C877B" fillcolor="#DCE8E0"];
  "DO10b" [label="DO10b\nNouveau mot de passe" shape=box style="rounded,filled" color="#8C877B" fillcolor="#DCE8E0"];
}
"SIDE" [label="Barre latérale" shape=box style="rounded,bold" color="#1C1B17" fillcolor="#FFFFFF"];
subgraph "cluster_dapp" { label="Coffre au bureau et sur tablette (D, T)"; fontname="Inter SemiBold"; fontsize=15; style="rounded"; color="#CFCAC0"; penwidth=1.2; margin=14;
  "T1" [label="T1\nTablette — Coffre" shape=box style="rounded,filled" color="#8C877B" fillcolor="#E8DCC6"];
  "D1" [label="D1\nCatégorie" shape=box style="rounded,filled" color="#8C877B" fillcolor="#E8DCC6"];
  "D2" [label="D2\nDocument" shape=box style="rounded,filled" color="#8C877B" fillcolor="#E8DCC6"];
  "D3" [label="D3\nArrivées" shape=box style="rounded,filled" color="#8C877B" fillcolor="#E8DCC6"];
  "D4" [label="D4\nSources" shape=box style="rounded,filled" color="#8C877B" fillcolor="#E8DCC6"];
}
"DMOI" [label="Moi (menu de l’avatar)\n(à dessiner)" shape=box style="rounded,dashed,filled" color="#8C877B" fillcolor="#F2F0EA" fontcolor="#5B574F"];
"DO1" -> "DO2" [color="#1F4D3A" penwidth=1.6 label="J’ai déjà un coffre"];
"DO1" -> "DO3" [color="#1F4D3A" penwidth=1.6 label="Créer mon coffre"];
"DO2" -> "DO2b" [color="#8C877B" style=dotted penwidth=1.6 arrowhead=open label="Ouvrir le coffre"];
"DO2b" -> "DO2c" [color="#8C877B" style=dotted penwidth=1.6 arrowhead=open label="échec"];
"DO2" -> "DO4b" [color="#2C5582" style=dashed penwidth=1.4 label="pas de trousseau"];
"DO2b" -> "DO5" [color="#1F4D3A" penwidth=1.6 label="limite d’appareils"];
"DO2b" -> "DO9" [color="#1F4D3A" penwidth=1.6 label="1re ouverture ici"];
"DO5" -> "DO9" [color="#1F4D3A" penwidth=1.6 label="appareil retiré"];
"DO5" -> "M9" [color="#1F4D3A" penwidth=1.6 label="Voir les offres"];
"DO2c" -> "DO10" [color="#1F4D3A" penwidth=1.6 label="kit de récupération"];
"DO2" -> "DO10" [color="#1F4D3A" penwidth=1.6 label="Mot de passe oublié ?"];
"DO10" -> "DO10b" [color="#1F4D3A" penwidth=1.6 label="Continuer"];
"DO10b" -> "DO9" [color="#1F4D3A" penwidth=1.6 label="Rouvrir mon coffre"];
"DO3" -> "DO3b" [color="#8C877B" style=dotted penwidth=1.6 arrowhead=open label="erreurs"];
"DO3" -> "DO4b" [color="#2C5582" style=dashed penwidth=1.4 label="pas de trousseau"];
"DO3" -> "DO6" [color="#1F4D3A" penwidth=1.6 label="Continuer"];
"DO6" -> "DO6b" [color="#1F4D3A" penwidth=1.6 label="Je l’ai noté"];
"DO6b" -> "DO7" [color="#1F4D3A" penwidth=1.6 label="Vérifier"];
"DO6" -> "DO7" [color="#1F4D3A" penwidth=1.6 label="Plus tard"];
"DO7" -> "DO7h" [color="#8C877B" style=dotted penwidth=1.6 arrowhead=open label="limite atteinte"];
"DO7" -> "DO7b" [color="#1F4D3A" penwidth=1.6 label="Connecter n sources"];
"DO7" -> "DO8" [color="#1F4D3A" penwidth=1.6 label="Passer"];
"DO7b" -> "DO7c" [color="#1F4D3A" penwidth=1.6 label="Connecter"];
"DO7b" -> "DO7f" [color="#8C877B" style=dotted penwidth=1.6 arrowhead=open label="refusé"];
"DO7c" -> "DO7d" [color="#2C5582" style=dashed penwidth=1.4 label="code SMS ou e-mail"];
"DO7c" -> "DO7b" [color="#1F4D3A" penwidth=1.6 label="Source suivante"];
"DO7c" -> "DO7g" [color="#1F4D3A" penwidth=1.6 label="dernière source"];
"DO7f" -> "DO7g" [color="#1F4D3A" penwidth=1.6 label="Passer (dernière)"];
"DO7g" -> "DO8" [color="#1F4D3A" penwidth=1.6 label="Continuer"];
"DO8" -> "SIDE" [color="#1F4D3A" penwidth=1.6];
"DO9" -> "SIDE" [color="#1F4D3A" penwidth=1.6 label="Parcourir le coffre"];
"SIDE" -> "T1" [color="#1F4D3A" penwidth=1.6 label="Tout le coffre"];
"SIDE" -> "D1" [color="#1F4D3A" penwidth=1.6 label="catégorie"];
"SIDE" -> "D3" [color="#1F4D3A" penwidth=1.6 label="Arrivées"];
"SIDE" -> "D4" [color="#1F4D3A" penwidth=1.6 label="Sources"];
"SIDE" -> "DMOI" [color="#B3261E" style=dashed penwidth=1.2 arrowhead=open label="avatar"];
"D1" -> "D2" [color="#1F4D3A" penwidth=1.6];
"T1" -> "D1" [color="#1F4D3A" penwidth=1.6 label="carte"];
subgraph cluster_legend { label="Légende"; fontname="Inter SemiBold"; fontsize=14; style=rounded; color="#CFCAC0";
  node [shape=plaintext fontsize=12 margin=0];
  la [label=""]; lb [label="on touche, l’écran change"]; lc [label=""]; ld [label="même écran, autre état"];
  le [label=""]; lf [label="feuille ou dialogue par-dessus"]; lg [label=""]; lh [label="vers une page à dessiner"];
  la -> lb [color="#1F4D3A" penwidth=1.6]; lc -> ld [color="#8C877B" style=dotted penwidth=1.6 arrowhead=open];
  le -> lf [color="#2C5582" style=dashed penwidth=1.4]; lg -> lh [color="#B3261E" style=dashed penwidth=1.2 arrowhead=open];
}
}